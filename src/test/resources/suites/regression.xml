<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="Regression" parallel="methods" thread-count="4">
    <test name="test-chrome">
        <parameter name="browser" value="chrome" />
        <groups>
            <run>
                <include name="regress"/>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="org.example.tests.internalpages"></package>
        </packages>
    </test>
    <test name="test-firefox">
        <parameter name="browser" value="firefox" />
        <groups>
            <run>
                <include name="regress"/>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="org.example.tests.internalpages"></package>
        </packages>
    </test>
    <test name="test-edge">
        <parameter name="browser" value="edge" />
        <groups>
            <run>
                <include name="regress"/>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="org.example.tests.internalpages"></package>
        </packages>
    </test>
</suite>